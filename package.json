    "valibot": "^1.1.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vite-plugin-vuetify": "^2.1.1",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.2.2",
    "vue": "^3.5.13"
